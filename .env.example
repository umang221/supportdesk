# Copy to .env.local and fill in real values there. .env.local (and every
# .env* variant) is gitignored — never commit real credentials.

MONGODB_URI=

# Cloudinary (ticket message attachments — server/attachments/attachmentService.js).
# Leave unset in development if you don't need to test uploads: everything
# else in the app works without it, and attempting an upload without these
# set returns a clear 503 rather than a confusing crash.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (server/email/emailProvider.js). Leave unset in development — email
# then goes through a log-only transport that never sends anything over the
# network. Set all three of HOST/USER/PASSWORD to send real email via SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SupportDesk <no-reply@supportdesk.local>"
